  "tokenColors": [
    { "name": "Plain text", "scope": ["source", "support.type.property-name.css"], "settings": { "foreground": "@syntaxForeground@" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "@syntaxComment@", "fontStyle": "italic" } },
    { "name": "Documentation", "scope": ["comment.documentation", "comment.line.documentation"], "settings": { "foreground": "@syntaxComment@" } },
    { "name": "Keywords", "scope": ["keyword", "storage.type", "storage.modifier", "keyword.modifier"], "settings": { "foreground": "@syntaxKeyword@" } },
    { "name": "Import keywords", "scope": ["keyword.control.import", "keyword.control.from", "keyword.import"], "settings": { "foreground": "@syntaxKeyword@" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "@syntaxOperator@" } },
    { "name": "Strings", "scope": ["string", "string.other.link"], "settings": { "foreground": "@syntaxString@" } },
    { "name": "Escapes", "scope": ["constant.character.escape", "constant.other.placeholder"], "settings": { "foreground": "@syntaxForeground@" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "@syntaxNumber@" } },
    { "name": "Constants", "scope": ["constant", "variable.other.constant", "variable.readonly"], "settings": { "foreground": "@syntaxConstant@" } },
    { "name": "Booleans", "scope": ["constant.language.boolean", "constant.language.json"], "settings": { "foreground": "@syntaxType@" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call.generic"], "settings": { "foreground": "@syntaxFunction@", "fontStyle": "bold" } },
    { "name": "Methods", "scope": ["entity.name.function.method", "meta.function.method"], "settings": { "foreground": "@syntaxString@" } },
    { "name": "Variables", "scope": ["variable", "meta.variable"], "settings": { "foreground": "@syntaxVariable@" } },
    { "name": "Properties", "scope": ["variable.other.property", "variable.other.object.property", "meta.property"], "settings": { "foreground": "@syntaxType@" } },
    { "name": "Parameters", "scope": ["variable.parameter", "meta.parameter"], "settings": { "foreground": "@syntaxVariable@" } },
    { "name": "Types", "scope": ["entity.name.type", "support.type", "entity.name.type.interface", "entity.name.type.class", "entity.name.type.struct", "entity.name.type.enum"], "settings": { "foreground": "@syntaxType@" } },
    { "name": "Namespaces", "scope": ["entity.name.namespace", "entity.name.module", "storage.modifier.namespace", "storage.modifier.module"], "settings": { "foreground": "@syntaxKeyword@" } },
    { "name": "Type parameters", "scope": ["variable.type.parameter", "variable.parameter.type"], "settings": { "foreground": "@syntaxString@" } },
    { "name": "Tags", "scope": ["entity.name.tag", "support.class.component"], "settings": { "foreground": "@syntaxFunction@" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name", "meta.attribute"], "settings": { "foreground": "@syntaxString@" } },
    { "name": "Decorators", "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"], "settings": { "foreground": "@syntaxKeyword@" } },
    { "name": "Exceptions", "scope": ["keyword.control.exception", "keyword.control.trycatch"], "settings": { "foreground": "@syntaxException@" } },
    { "name": "Preprocessor", "scope": ["entity.name.function.preprocessor", "meta.preprocessor"], "settings": { "foreground": "@syntaxKeyword@" } },
    { "name": "Punctuation", "scope": ["punctuation", "punctuation.terminator", "punctuation.separator"], "settings": { "foreground": "@syntaxOperator@" } },
    { "name": "Markdown headings", "scope": ["entity.name.section.markdown", "markup.heading.markdown", "punctuation.definition.heading.markdown"], "settings": { "foreground": "@markupHeading@", "fontStyle": "bold" } },
    { "name": "Markdown links", "scope": ["markup.underline.link", "string.other.link.title.markdown"], "settings": { "foreground": "@markupLink@", "fontStyle": "underline" } },
    { "name": "Markdown emphasis", "scope": ["markup.italic.markdown"], "settings": { "foreground": "@markupEmphasis@", "fontStyle": "italic" } },
    { "name": "Markdown strong", "scope": ["markup.bold.markdown"], "settings": { "foreground": "@markupStrong@", "fontStyle": "bold" } },
    { "name": "Markdown code", "scope": ["markup.inline.raw.string.markdown", "markup.fenced_code.block.markdown"], "settings": { "foreground": "@markupCode@" } },
    { "name": "Markdown quotes", "scope": ["markup.quote.markdown", "punctuation.definition.quote.begin.markdown"], "settings": { "foreground": "@markupQuote@" } },
    { "name": "Diff inserted", "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "@diffAdded@" } },
    { "name": "Diff deleted", "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "@diffRemoved@" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "@diffModified@" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "@syntaxException@" } }
  ],
  "semanticTokenColors": {
    "namespace": "@syntaxKeyword@",
    "type": "@syntaxType@",
    "class": "@syntaxType@",
    "enum": "@syntaxType@",
    "interface": "@syntaxType@",
    "struct": "@syntaxType@",
    "typeParameter": "@syntaxString@",
    "parameter": "@syntaxVariable@",
    "variable": "@syntaxVariable@",
    "variable.readonly": "@syntaxConstant@",
    "property": "@syntaxType@",
    "enumMember": "@syntaxConstant@",
    "decorator": "@syntaxKeyword@",
    "event": "@syntaxFunction@",
    "function": { "foreground": "@syntaxFunction@", "bold": true },
    "method": "@syntaxString@",
    "macro": "@syntaxKeyword@",
    "label": "@syntaxFunction@",
    "comment": { "foreground": "@syntaxComment@", "italic": true },
    "string": "@syntaxString@",
    "number": "@syntaxNumber@",
    "regexp": "@syntaxString@",
    "operator": "@syntaxOperator@",
    "keyword": "@syntaxKeyword@"
  }
}
